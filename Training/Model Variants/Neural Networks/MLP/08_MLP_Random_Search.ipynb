    "X_validation = np.load(CACHE_DIR / \"X_validation.npy\")\n",
    "y_validation = np.load(CACHE_DIR / \"y_validation.npy\")\n",
    "validation_metadata = pd.read_csv(CACHE_DIR / \"validation_metadata.csv\")\n",
