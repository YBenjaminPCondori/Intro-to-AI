   "source": [
    "# Purpose: 5. One MFCC Cache, Scaler and Class Weights.\n",
    "def load_audio_fixed(path):\n",
    "    # Purpose: Loads one audio file, converts it to mono, resamples it, and forces a fixed duration.\n",
    "    audio, _ = librosa.load(path, sr=SAMPLE_RATE, mono=True)\n",
    "    if len(audio) > TARGET_SAMPLES:\n",
    "        audio = audio[:TARGET_SAMPLES]\n",
    "    elif len(audio) < TARGET_SAMPLES:\n",
    "        audio = np.pad(audio, (0, TARGET_SAMPLES - len(audio)))\n",
    "    return audio.astype(np.float32)\n",
    "\n",
    "\n",
    "def extract_mfcc_vector(path):\n",
    "    # Purpose: Converts one audio file into the fixed-length MFCC mean/std vector used by tabular models.\n",
    "    audio = load_audio_fixed(path)\n",
    "    mfcc = librosa.feature.mfcc(y=audio, sr=SAMPLE_RATE, n_mfcc=N_MFCC, n_fft=N_FFT, hop_length=HOP_LENGTH, win_length=WIN_LENGTH, window=\"hann\")\n",
    "    return np.concatenate([mfcc.mean(axis=1), mfcc.std(axis=1)]).astype(np.float32)\n",
    "\n",
    "\n",
    "def build_feature_table(split_manifest, split_name):\n",
    "    # Purpose: Builds a feature matrix and label vector for every row in one manifest split.\n",
    "    features, labels, skipped = [], [], []\n",
    "    # Purpose: Processes one manifest row at a time so every audio file receives one feature vector and label.\n",
    "    for row_index, row in split_manifest.reset_index(drop=True).iterrows():\n",
    "        try:\n",
    "            features.append(extract_mfcc_vector(row[\"path\"]))\n",
    "            labels.append(int(row[\"label\"]))\n",
    "        except Exception as exc:\n",
    "            skipped.append({\"split\": split_name, \"row_index\": int(row_index), \"path\": row[\"path\"], \"error\": str(exc)})\n",
    "    if skipped:\n",
    "        # Purpose: Saves the generated artifacts so later notebooks, reports, or reruns can inspect the same\n",
    "        # Purpose: outputs.\n",
    "        pd.DataFrame(skipped).to_csv(TABLES_DIR / \"mfcc_extraction_skipped.csv\", index=False)\n",
    "        raise RuntimeError(\"MFCC extraction failed for at least one file.\")\n",
    "    return np.vstack(features).astype(np.float32), np.asarray(labels, dtype=np.int64)\n",
    "\n",
    "\n",
    "feature_config_path = CACHE_DIR / \"feature_config.json\"\n",
    "cache_is_current = False\n",
    "if feature_config_path.exists():\n",
    "    with open(feature_config_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        cache_is_current = json.load(f).get(\"final_split_version\") == FINAL_SPLIT_VERSION\n",
    "\n",
    "if cache_is_current:\n",
    "    print(\"Existing final MLP cache is current:\", CACHE_DIR)\n",
    "elif RUN_FULL_MLP_DATA_PREPARATION and all(path.exists() for path in [train_manifest_path, validation_manifest_path, test_manifest_path]):\n",
    "    train_manifest = pd.read_csv(train_manifest_path)\n",
    "    validation_manifest = pd.read_csv(validation_manifest_path)\n",
    "    test_manifest = pd.read_csv(test_manifest_path)\n",
    "    X_train_raw, y_train = build_feature_table(train_manifest, \"train\")\n",
    "    X_validation_raw, y_validation = build_feature_table(validation_manifest, \"validation\")\n",
    "    X_test_raw, y_test = build_feature_table(test_manifest, \"test\")\n",
    "    scaler = StandardScaler()\n",
    "    X_train = scaler.fit_transform(X_train_raw).astype(np.float32)\n",
    "    X_validation = scaler.transform(X_validation_raw).astype(np.float32)\n",
    "    X_test = scaler.transform(X_test_raw).astype(np.float32)\n",
    "    labels = np.unique(y_train)\n",
    "    values = compute_class_weight(class_weight=\"balanced\", classes=labels, y=y_train)\n",
    "    class_weights = {int(label): float(weight) for label, weight in zip(labels, values)}\n",
    "    np.save(CACHE_DIR / \"X_train.npy\", X_train)\n",
    "    np.save(CACHE_DIR / \"y_train.npy\", y_train)\n",
    "    np.save(CACHE_DIR / \"X_validation.npy\", X_validation)\n",
    "    np.save(CACHE_DIR / \"y_validation.npy\", y_validation)\n",
    "    np.save(CACHE_DIR / \"X_test.npy\", X_test)\n",
    "    np.save(CACHE_DIR / \"y_test.npy\", y_test)\n",
    "    train_manifest.to_csv(CACHE_DIR / \"train_metadata.csv\", index=False)\n",
    "    validation_manifest.to_csv(CACHE_DIR / \"validation_metadata.csv\", index=False)\n",
    "    test_manifest.to_csv(CACHE_DIR / \"test_metadata.csv\", index=False)\n",
    "    joblib.dump(scaler, CACHE_DIR / \"standard_scaler.joblib\")\n",
    "    joblib.dump(scaler, CACHE_DIR / \"scaler.joblib\")\n",
    "    with open(CONFIGS_DIR / \"class_weights.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump({\"class_weights\": {str(k): v for k, v in class_weights.items()}, \"source\": \"canonical y_train only\", \"final_split_version\": FINAL_SPLIT_VERSION}, f, indent=2)\n",
    "    feature_config = {\"final_split_version\": FINAL_SPLIT_VERSION, \"representation\": \"40 MFCC means + 40 MFCC standard deviations = 80-D vector\", \"feature_dim\": int(X_train.shape[1]), \"scaler\": \"StandardScaler fitted on X_train_raw only\", \"test_features_prepared_but_not_evaluated\": True}\n",
    "    with open(feature_config_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(feature_config, f, indent=2)\n",
    "else:\n",
    "    print(\"Final MLP cache is missing or outdated. Set RUN_FULL_MLP_DATA_PREPARATION = True to build it intentionally.\")\n"
